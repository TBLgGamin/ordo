---
interface Props {
	title: string
	accent: string
	class?: string
}

const { title, accent, class: className } = Astro.props
---

<div class:list={["max-w-2xl", className]}>
	<h2 class="text-4xl font-bold tracking-tight sm:text-5xl 2xl:text-6xl">
		<span class="block">{title}</span>
		<span class="block text-ring">{accent}</span>
	</h2>
	<div class="mt-6 text-base leading-relaxed text-muted-foreground sm:text-lg">
		<slot />
	</div>
</div>

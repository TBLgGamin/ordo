---
import { Button } from "@/components/ui/button"
import InstallTerminal from "@/components/InstallTerminal.astro"
import MediaPanel from "@/components/MediaPanel.astro"
---

<section id="top" class="overflow-x-clip">
	<div class="mx-auto grid min-h-[calc(100svh-4rem)] w-full max-w-[1680px] grid-cols-[minmax(0,1fr)] items-center gap-12 px-6 py-16 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-14 lg:px-12 lg:py-10">
		<div class="max-w-xl">
			<h1 class="text-5xl font-bold tracking-tighter sm:text-7xl">
				<span class="reveal-line"><span>Bring order to</span></span>
				<span class="reveal-line"><span class="text-ring" style="--delay: 90ms">your terminal.</span></span>
			</h1>
			<p class="mt-6 max-w-md text-base leading-relaxed text-muted-foreground sm:text-lg" data-rise style="--delay: 250ms">
				ordo is a tiling terminal multiplexer for Windows, macOS, and Linux. It arranges your
				shells around you in real windows and keeps every one alive in a daemon that outlives
				them. When a pane runs an AI agent, ordo wires it in over MCP so your agents can work
				as a team.
			</p>
			<div class="mt-8 max-w-lg" data-rise style="--delay: 340ms">
				<InstallTerminal />
			</div>
			<div class="mt-5 flex flex-wrap items-center gap-3" data-rise style="--delay: 430ms">
				<Button size="lg" as="a" href="#install">Get started</Button>
				<Button variant="ghost" size="lg" as="a" href="/docs">Read the docs</Button>
				<Button variant="ghost" size="lg" as="a" href="https://github.com/TBLgGamin/ordo">View on GitHub</Button>
			</div>
			<p class="mt-8 text-sm text-muted-foreground" data-rise style="--delay: 520ms">
				Free and open source &middot; one-command install &middot; no cloud &middot; any terminal
			</p>
		</div>
		<div class="hidden lg:block" data-rise style="--delay: 200ms">
			<MediaPanel src="/product/hero-formation.png" alt="" loading="eager" />
		</div>
	</div>
</section>

---
import SectionHeading from "@/components/SectionHeading.astro"
import MediaPanel from "@/components/MediaPanel.astro"

const points = [
	{
		step: "01",
		title: "Warm restore",
		description: "Reopen a session while the daemon lives and every pane reattaches to its still-running shell. Nothing restarts, nothing is lost.",
	},
	{
		step: "02",
		title: "Cold restore",
		description: "After a reboot, panes are rebuilt from captured scrollback and working directories, and the program that was running is launched again.",
	},
	{
		step: "03",
		title: "Names with rank",
		description: "Every session gets a stable Roman id like centurion-optio, and a local model writes the human title from what is on screen.",
	},
]
---

<section id="sessions" class="scroll-mt-16 overflow-x-clip py-20 sm:py-28">
	<div class="mx-auto grid w-full max-w-[1680px] grid-cols-[minmax(0,1fr)] items-center gap-10 px-6 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-14 lg:px-12">
		<div data-reveal>
			<SectionHeading title="Close everything." accent="Lose nothing.">
				<p>
					Your shells do not live in the windows. They live in a hidden daemon that keeps
					running after every window is gone. A closed window is just a detached one.
				</p>
			</SectionHeading>
			<dl class="mt-10 flex flex-col gap-8">
				{points.map((point) => (
					<div class="flex gap-5">
						<span class="w-8 shrink-0 text-xl leading-6 font-bold tabular-nums text-ring">{point.step}</span>
						<div>
							<dt class="font-semibold">{point.title}</dt>
							<dd class="mt-1 max-w-md text-sm leading-relaxed text-muted-foreground">{point.description}</dd>
						</div>
					</div>
				))}
			</dl>
		</div>
		<MediaPanel
			data-reveal
			src="/product/session-restore.png"
			alt="Ordo's command center with a saved session, its panes and their statuses, ready to reopen."
		/>
	</div>
</section>

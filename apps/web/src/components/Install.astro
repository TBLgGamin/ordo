---
import { Button } from "@/components/ui/button"
import InstallTerminal from "@/components/InstallTerminal.astro"
import SectionHeading from "@/components/SectionHeading.astro"

const steps = [
	{
		step: "01",
		title: "Run the installer",
		description: "One command fetches ordo and checks its prerequisites for you.",
	},
	{
		step: "02",
		title: "Type ordo",
		description: "The launcher opens in a fresh window with your saved sessions ready to restore.",
	},
	{
		step: "03",
		title: "Spawn your panes",
		description: "Add shells or agents from the launcher or with ordo spawn. They tile into formation, and agents get their MCP radio automatically.",
	},
]
---

<section id="install" class="scroll-mt-16 py-24 sm:py-32">
	<div class="mx-auto flex w-full max-w-3xl flex-col items-center gap-12 px-6 text-center" data-reveal>
		<SectionHeading title="Deployed in" accent="under a minute." class="flex max-w-none flex-col items-center">
			<p class="mx-auto max-w-xl">
				Works on Windows, macOS, and Linux. ordo detects your terminal and tells you if
				anything is missing.
			</p>
		</SectionHeading>
		<div class="w-full max-w-2xl text-left">
			<InstallTerminal />
		</div>
		<ol class="grid w-full gap-10 text-left sm:grid-cols-3">
			{steps.map((item) => (
				<li class="flex flex-col gap-3">
					<span class="text-xl leading-none font-bold tabular-nums text-ring">{item.step}</span>
					<div>
						<h3 class="font-semibold">{item.title}</h3>
						<p class="mt-1 text-sm leading-relaxed text-muted-foreground">{item.description}</p>
					</div>
				</li>
			))}
		</ol>
		<Button variant="secondary" size="lg" as="a" href="https://github.com/TBLgGamin/ordo">
			Read the source on GitHub
		</Button>
	</div>
</section>

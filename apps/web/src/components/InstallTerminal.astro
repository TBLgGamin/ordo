---
import CopyButton from "@/components/CopyButton.vue"
import { highlightTerminalCode } from "@/lib/highlight"

const PS = "irm https://raw.githubusercontent.com/TBLgGamin/ordo/main/scripts/install.ps1 | iex"
const SH = "curl -fsSL https://raw.githubusercontent.com/TBLgGamin/ordo/main/scripts/install.sh | bash"

const tabs = await Promise.all([
	{
		id: "windows",
		label: "Windows",
		command: PS,
		prompt: "PS>",
		lang: "powershell" as const,
	},
	{
		id: "macos",
		label: "macOS",
		command: SH,
		prompt: "$",
		lang: "shellscript" as const,
	},
	{
		id: "linux",
		label: "Linux",
		command: SH,
		prompt: "$",
		lang: "shellscript" as const,
	},
].map(async (tab) => ({
	...tab,
	highlighted: await highlightTerminalCode(tab.command, tab.lang),
})))
---

<div class="w-full" data-install-terminal>
	<div class="overflow-hidden rounded-xl border bg-muted/50 dark:bg-card">
		<div class="flex h-11 items-stretch gap-1 border-b pr-1.5 pl-2" role="tablist" aria-label="Install command">
			{tabs.map((tab, index) => (
				<button
					type="button"
					role="tab"
					id={`install-tab-${tab.id}`}
					aria-controls={`install-panel-${tab.id}`}
					aria-selected={index === 0 ? "true" : "false"}
					data-install-tab={tab.id}
					class="relative px-2.5 text-xs font-medium text-muted-foreground transition-colors outline-none hover:text-foreground focus-visible:text-foreground focus-visible:ring-3 focus-visible:ring-ring/50 aria-selected:text-foreground after:absolute after:inset-x-2.5 after:-bottom-px after:h-0.5 after:rounded-full after:bg-foreground after:opacity-0 aria-selected:after:opacity-100"
				>
					{tab.label}
				</button>
			))}
			<div class="ml-auto flex items-center">
				{tabs.map((tab, index) => (
					<div data-install-copy={tab.id} class:list={[index !== 0 && "hidden"]}>
						<CopyButton client:load text={tab.command} />
					</div>
				))}
			</div>
		</div>

		<div class="min-w-0">
			{tabs.map((tab, index) => (
				<div id={`install-panel-${tab.id}`} role="tabpanel" aria-labelledby={`install-tab-${tab.id}`} data-install-panel={tab.id} class:list={[index !== 0 && "hidden"]}>
					<div class="flex min-w-0 items-start gap-3 overflow-x-auto px-4 py-3.5">
						<span class="select-none pt-[0.1rem] font-mono text-sm text-ring">{tab.prompt}</span>
						<div class="terminal-code min-w-0 flex-1" set:html={tab.highlighted} />
					</div>
				</div>
			))}
		</div>
	</div>
</div>

<script>
	const roots = document.querySelectorAll("[data-install-terminal]")

	function detectOs() {
		const hint = `${navigator.platform ?? ""} ${navigator.userAgent ?? ""}`.toLowerCase()
		if (hint.includes("mac") || hint.includes("iphone") || hint.includes("ipad")) return "macos"
		if (hint.includes("linux") || hint.includes("android")) return "linux"
		return "windows"
	}

	function setActive(root, id) {
		root.querySelectorAll("[data-install-tab]").forEach((tab) => {
			const active = tab.getAttribute("data-install-tab") === id
			tab.setAttribute("aria-selected", String(active))
		})

		root.querySelectorAll("[data-install-panel]").forEach((panel) => {
			panel.classList.toggle("hidden", panel.getAttribute("data-install-panel") !== id)
		})

		root.querySelectorAll("[data-install-copy]").forEach((copy) => {
			copy.classList.toggle("hidden", copy.getAttribute("data-install-copy") !== id)
		})
	}

	for (const root of roots) {
		setActive(root, detectOs())
		root.querySelectorAll("[data-install-tab]").forEach((tab) => {
			tab.addEventListener("click", () => {
				const id = tab.getAttribute("data-install-tab")
				if (id) setActive(root, id)
			})
		})
	}
</script>

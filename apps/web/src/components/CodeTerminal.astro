---
import { highlightTerminalCode } from "@/lib/highlight"

interface Props {
	code: string
	title: string
	lang?: "shellscript" | "powershell"
	label?: string
	class?: string
}

const { code, title, lang = "shellscript", label, class: className } = Astro.props
const highlighted = await highlightTerminalCode(code, lang)
---

<div class:list={["overflow-hidden rounded-xl border bg-muted/50 dark:bg-card", className]}>
	<div class="flex h-10 items-center gap-2 border-b px-4">
		<span class="min-w-0 truncate font-mono text-xs text-muted-foreground">{title}</span>
		{label && <span class="ml-auto rounded-full bg-secondary px-2 py-0.5 text-xs font-medium text-secondary-foreground">{label}</span>}
	</div>
	<div class="terminal-code overflow-x-auto px-4 py-3" set:html={highlighted} />
</div>
